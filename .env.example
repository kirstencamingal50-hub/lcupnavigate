# Source MySQL connection. Use a URL-encoded password and keep real credentials
# outside the repository. This value is used only by the one-time import script.
SOURCE_MYSQL_URL=mysql://migration_user:replace-me@127.0.0.1:3306/lcup_campus_nav

# Target managed PostgreSQL URL for a local one-time import process.
DATABASE_URL=postgresql://navigate_app:replace-me@db.example.net:5432/navigate?sslmode=require

# Netlify production settings (set in Netlify UI, never in frontend code).
NETLIFY_SITE_ORIGIN=https://navigate.example.net
ALLOWED_ORIGINS=https://navigate.example.net
SESSION_COOKIE_SAMESITE=Lax
RESEND_API_KEY=replace-with-email-provider-api-key
EMAIL_FROM=NaviGATE <noreply@example.net>
INITIAL_ADMIN_SETUP_TOKEN=replace-with-at-least-32-random-bytes

# Netlify Blobs migration tool credentials. Set only in a local shell for the
# one-time migration; do not commit or paste real credentials into source code.
NETLIFY_SITE_ID=replace-with-site-id
NETLIFY_AUTH_TOKEN=replace-with-netlify-personal-access-token
